{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "start": "node server-dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check": "tsx scripts/check-hunt-logic.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
