# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional fetch relay for auction sites that refuse requests from Vercel's servers.
# Interencheres answers 403 from Vercel (US and Paris regions, tested 8 Oct 2026), so its direct search only
# works through a relay. Leave unset to fetch directly (Drouot works directly from Vercel's Paris region).
# Contract: GET ${FETCH_RELAY_URL}?url=<encoded target url> with header X-Relay-Key: ${FETCH_RELAY_KEY};
# the relay answers with the target's status code and body and should only allow the auction hosts.
# FETCH_RELAY_URL="https://relay.example.com/fetch"
# FETCH_RELAY_KEY="long-random-secret"
# FETCH_RELAY_HOSTS="interencheres.com"
